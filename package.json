{
  "name": "daedalos",
  "version": "2.0.0",
  "description": "Desktop environment in the browser",
  "author": {
    "name": "Dustin Brett",
    "email": "dustinbrett@gmail.com",
    "url": "https://dustinbrett.com"
  },
  "license": "MIT",
  "browserslist": [
    "chrome >= 80",
    "edge >= 80",
    "firefox >= 74",
    "safari >= 13.1",
    "ios_saf >= 13.4"
  ],
  "scripts": {
    "build": "yarn build:prebuild && next build --webpack",
    "build:bundle-analyzer": "yarn build",
    "build:fs:private": "node scripts/fs2json.js --out public/.index/fs.private.9p.json ./public/private",
    "build:fs:public": "node scripts/fs2json.js --exclude .index,private --out public/.index/fs.9p.json ./public",
    "build:minify": "node scripts/minifyHtml.js && node scripts/minifyJs.js",
    "build:prebuild": "node scripts/robots.js && node scripts/rssBuilder.js && node scripts/searchIndex.js && node scripts/preloadIcons.js && node scripts/cacheShortcuts.js && yarn build:fs:public",
    "docker:build": "docker build -t daedalos .",
    "docker:run": "docker run -dp 3000:3000 --rm --name daedalos daedalos",
    "dev": "next dev --webpack",
    "dev:ssl": "cross-env TRUST_STORES=system next dev --webpack --experimental-https",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "oxlint",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "serve": "serve out",
    "stylelint": "stylelint --formatter=verbose **/*.ts*",
    "test": "jest",
    "unused-scan": "knip",
    "update": "yarn upgrade-interactive --latest"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.{ts,tsx}": "stylelint --fix",
    "*.{js,ts,tsx}": "oxlint --fix --no-error-on-unmatched-pattern"
  },
  "resolutions": {
    "@emotion/is-prop-valid": "^1.4.0"
  },
  "dependencies": {
    "@chrisoakman/chessboard2": "^0.5.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@mlc-ai/web-llm": "^0.2.79",
    "@monaco-editor/loader": "1.7.0",
    "@panzoom/panzoom": "^4.6.2",
    "@prettier/plugin-xml": "^3.4.2",
    "@wasmer/wasm-transformer": "^0.12.0",
    "Burn-My-Windows": "https://github.com/Schneegans/Burn-My-Windows",
    "ani-cursor": "^2.3.1",
    "browserfs": "https://github.com/jvilk/BrowserFS.git#a96aa2d",
    "butterchurn-presets": "^3.0.0-beta.4",
    "canvas-confetti": "^1.9.4",
    "chess.js": "^1.4.0",
    "decode-ico": "^0.4.1",
    "dompurify": "^3.4.16",
    "exif-js": "^2.3.0",
    "fflate": "^0.8.3",
    "file-type": "^22.1.1",
    "fix-webm-duration": "^1.0.6",
    "gif.js": "^0.2.0",
    "idb": "^8.0.3",
    "ini": "^7.0.0",
    "isomorphic-git": "^1.42.5",
    "mediainfo.js": "0.3.8",
    "minimist": "^1.2.8",
    "motion": "^13.4.6",
    "multiformats": "^14.0.5",
    "music-metadata-browser": "^2.5.11",
    "next": "^16.3.8",
    "nostr-tools": "^1.17.0",
    "opentype.js": "^2.0.0",
    "playlist-parser": "^0.0.12",
    "prettier": "^3.9.9",
    "print-js": "^1.6.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-rnd": "^10.5.3",
    "resedit": "^3.1.0",
    "rtf.js": "^3.0.9",
    "stockfish": "^19.0.0",
    "styled-components": "^6.5.3",
    "utif": "https://github.com/photopea/UTIF.js",
    "wasi-js": "^1.7.3"
  },
  "devDependencies": {
    "7z-wasm": "^1.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dom-chromium-ai": "0.0.6",
    "@types/gif.js": "^0.2.5",
    "@types/ini": "^4.1.1",
    "@types/jest": "^30.0.0",
    "@types/lunr": "^2.3.7",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.3",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "@types/video.js": "^7.3.58",
    "@types/wicg-file-system-access": "^2023.10.7",
    "cross-env": "^10.1.0",
    "emulators": "^8.5.0",
    "emulators-ui": "^0.73.9",
    "eruda": "^3.4.3",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks-addons": "^0.6.0",
    "eslint-plugin-regexp": "^3.3.1",
    "html-minifier-terser": "^7.2.0",
    "html-to-image": "^1.11.13",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "lunr": "^2.3.9",
    "monaco-editor": "^0.57.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-styled-syntax": "^0.7.3",
    "react-draggable": "^4.7.2",
    "serve": "^14.2.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "terser": "^5.51.2",
    "tinymce": "6.7.0",
    "typescript": "^7.0.2",
    "webamp": "^2.3.1",
    "webpack": "^5.111.1",
    "xlsx": "^0.18.5",
    "xterm": "^5.3.0"
  }
}
